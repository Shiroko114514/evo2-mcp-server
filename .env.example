# Copy this file to `.env` and fill in your key.
# Never commit `.env` to Git.

# Required. Obtain from https://build.nvidia.com/ (top-right "Get API Key").
# The key looks like: nvapi-XXXXXXXX...
NVIDIA_API_KEY=

# Optional. Base URL for the Evo2-7B Forward API. The default is the hosted
# NVIDIA endpoint (marked deprecated on build.nvidia.com — see README). Point
# this at a self-hosted NIM container, e.g. http://localhost:8000/biology/arc/evo2
# (NIM container path is /biology/arc/evo2/forward).
# Default: https://health.api.nvidia.com/v1/biology/arc/evo2-7b
# EVO2_MCP_BASE_URL=https://health.api.nvidia.com/v1/biology/arc/evo2-7b

# Optional. HTTP read timeout in seconds. Default: 120 (long sequences are slow).
# EVO2_MCP_TIMEOUT=120

# Optional. Max retries on 408 / 429 / 5xx (exponential backoff + jitter).
# Default: 4.
# EVO2_MCP_MAX_RETRIES=4

# Optional. Max concurrent requests for batch_score / score_fasta. Default: 2.
# NVIDIA's hosted NIM is rate-limited; keep this low.
# EVO2_MCP_MAX_CONCURRENCY=2

# Optional. Colon-separated (Unix) or semicolon-separated (Windows) list of
# directories the FASTA reader is allowed to open. Default: none, meaning
# `evo2_score_fasta` refuses to open any local path and only accepts inline
# FASTA text. Example:
# EVO2_MCP_ALLOWED_DIRS=/data/genomes:/home/me/projects

# Optional. Directory where large forward outputs (.npz) are saved when
# mode="save" (also the only place save_path may point). Default: ./output
# (relative to the process working dir).
# EVO2_MCP_OUTPUT_DIR=./output

# Optional. Allow 'N' (ambiguous) bases to be passed through to the API.
# Default: 0 (N is rejected with a clear error). Evo2's byte-level tokenizer
# can encode N, but the pretrained model was not evaluated on ambiguous bases —
# only enable this if you understand the caveat.
# EVO2_MCP_ALLOW_AMBIGUOUS=0

# Optional. Hard upper bound on sequence length (bp) for any tool input.
# Default: 1000000 (Evo2 7B was trained to 1M context).
# EVO2_MCP_MAX_SEQUENCE_LENGTH=1000000

# Optional. Cap on the total number of tensor values inlined by mode="raw".
# Default: 4096. Larger tensors must be saved with mode="save".
# EVO2_MCP_RAW_INLINE_MAX=4096

# Optional. Cap on per-position likelihood values returned by evo2_score /
# evo2_variant_score when include_per_position=true (head+tail). Default: 5000.
# EVO2_MCP_MAX_PER_POSITION=5000

# Optional. Layer name used to request the final logits for scoring.
#   auto       (default) try 'output_layer' (documented NIM name), and if the
#              server rejects it with "has no attribute" (the hosted
#              health.api.nvidia.com endpoint — verified live), switch to
#              'unembed' and cache the working name.
#   <name>     explicit: use it as-is (e.g. EVO2_MCP_LOGITS_LAYER=unembed for
#              the hosted API, or EVO2_MCP_LOGITS_LAYER=output_layer for a
#              self-hosted NIM 2.x container).
# EVO2_MCP_LOGITS_LAYER=auto
